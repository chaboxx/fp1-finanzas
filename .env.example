# Copia este archivo a .env.local y completa con los datos de tu proyecto Supabase
# (Dashboard → Project Settings → API Keys / Data API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opcionales, solo servidor: generación diaria de recurrentes en producción.
# Sin estas variables, se generan al abrir Resumen/Movimientos o al pulsar Procesar pendientes.
SUPABASE_SECRET_KEY=
CRON_SECRET=
